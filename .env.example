# Salin jadi .env lalu isi. Kosongkan EXPO_PUBLIC_API_URL untuk MODE DEMO (data contoh, tanpa server).
# Catatan: semua variabel EXPO_PUBLIC_* ikut tertanam di aplikasi dan bisa dibaca siapa pun —
# JANGAN taruh API key / rahasia di sini. Kunci AI (mis. Anthropic) disimpan di server backend.

# Alamat backend tim, tanpa garis miring di akhir. Contoh: https://api.tambak.example.com
EXPO_PUBLIC_API_URL=

# Opsional: endpoint saran AI kalau tidak berada di {API_URL}/ai/mitigasi
EXPO_PUBLIC_AI_URL=
